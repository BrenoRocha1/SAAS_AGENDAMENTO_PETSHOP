# Mesmo projeto Supabase do dashboard web (petshop-app/.env.local) — o app
# mobile fala com o MESMO backend, banco e autenticação, nunca um paralelo.
# Copie este arquivo para .env e preencha com os mesmos valores de
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY do dashboard web.
# EXPO_PUBLIC_ é o prefixo que o Expo expõe pro bundle do app — mesmo nível
# de "público" que NEXT_PUBLIC_ no Next.js. NUNCA coloque aqui a
# SUPABASE_SERVICE_ROLE_KEY (essa é só server-side).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
